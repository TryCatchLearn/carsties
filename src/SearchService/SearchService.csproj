<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Mapster" Version="10.0.11" />
      <PackageReference Include="MeiliSearch" Version="0.20.0" />
      <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
      <PackageReference Include="WolverineFx.RabbitMQ" Version="6.24.5" />
      <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.24.5" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Contracts\Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

</Project>
